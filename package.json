{
  "name": "tenure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@tenure/api --filter=@tenure/web",
    "build": "turbo run build",
    "typecheck": "tsc -b tsconfig.json apps/e2e",
    "lint": "turbo run lint",
    "test": "vitest run",
    "format": "prettier --write .",
    "seed": "node apps/api/src/seed.ts",
    "demo:reset": "node apps/api/src/seed.ts --reset",
    "backup": "node apps/api/src/ops/backup.ts",
    "restore": "node apps/api/src/ops/restore.ts",
    "stall": "npm run build -w @tenure/web && node apps/api/src/main.ts --stall",
    "e2e": "playwright test -c apps/e2e",
    "e2e:install": "node apps/e2e/scripts/install.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-boundaries": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
